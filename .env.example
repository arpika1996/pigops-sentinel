# PigOps Sentinel — local configuration. Copy to `.env` and fill in.
# `.env` is git-ignored. NEVER commit real values or service-account keys.

# ---- Google Cloud / Vertex AI ---------------------------------------------
GOOGLE_CLOUD_PROJECT=pigops-sentinel
# Region for Cloud Run / Firestore / Scheduler.
GCP_REGION=europe-west1
# Location used for Gemini calls on Vertex AI. Gemini 3.5 models are served
# from the `global` location (they are NOT available from europe-west1).
GOOGLE_CLOUD_LOCATION=global
# Route ALL model calls through Vertex AI (billing lands on the Vertex AI line,
# never on generativelanguage.googleapis.com). Both variable names are set on
# purpose: `GOOGLE_GENAI_USE_ENTERPRISE` is the current name in google-genai
# >= 2.x / ADK >= 2.x, `GOOGLE_GENAI_USE_VERTEXAI` keeps older SDKs working.
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Do NOT set GOOGLE_API_KEY / GEMINI_API_KEY — the app refuses to start if it
# finds one, because that would silently bypass Vertex AI.
GEMINI_MODEL=gemini-3.5-flash

# ---- Firestore ------------------------------------------------------------
# Leave empty to use the real database of GOOGLE_CLOUD_PROJECT (via ADC:
# `gcloud auth application-default login`). Set to use the local emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ---- Agent tuning (all optional, defaults shown) --------------------------
SCAN_INTERVAL_MINUTES=15
MORTALITY_SPIKE_THRESHOLD=4
MORTALITY_BASELINE_DAYS=14
VALVE_CHANGE_THRESHOLD=6
SILENT_ROOM_HOURS=36
ESCALATION_HOURS=24
MAX_TASKS_PER_RUN=5
DEDUP_WINDOW_HOURS=48
DEMO_FARM_ID=demo-farm

# ---- Console --------------------------------------------------------------
CONSOLE_PORT=8081
